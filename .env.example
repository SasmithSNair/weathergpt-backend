# Get this from https://neon.tech (Cloud PostgreSQL)
DATABASE_URL=postgresql://username:password@hostname/database_name

# Optional caching layer — leave as-is if you're not using Redis yet
REDIS_URL=redis://localhost:6379

# Get this from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# Get this from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
